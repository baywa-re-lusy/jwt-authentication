{
    "name": "baywa-re-lusy/jwt-authentication",
    "description": "BayWa r.e. LUSY JWT Authentication",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/baywa-re-lusy/jwt-authentication",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "laminas/laminas-hydrator": "^4.3",
        "laminas/laminas-permissions-acl": "^2.10",
        "symfony/security-core": "^7.4",
        "firebase/php-jwt": "^7.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.5",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "BayWaReLusy\\JwtAuthentication\\": "src/JwtAuthentication"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BayWaReLusy\\JwtAuthentication\\Test\\": "tests"
        }
    }
}
